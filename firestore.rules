rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'baikganteng88@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /students/{studentId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.id == studentId
        && request.resource.data.name is string
        && request.resource.data.arabicName is string
        && request.resource.data.level is string
        && request.resource.data.status in ['Lulus', 'Proses']
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && request.resource.data.scores is list
        && request.resource.data.scores.size() == 11;
      allow delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.arabicName is string
        && request.resource.data.order is number
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    match /settings/institution {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.arabicName is string
        && request.resource.data.foundation is string
        && request.resource.data.arabicFoundation is string
        && request.resource.data.city is string
        && request.resource.data.principal is string
        && request.resource.data.arabicAddress is string;
    }

    match /settings/certificate-template {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.logoDataUrl is string
        && request.resource.data.logoDataUrl.size() <= 400000
        && request.resource.data.watermarkDataUrl is string
        && request.resource.data.watermarkDataUrl.size() <= 400000
        && request.resource.data.watermarkOpacity is number
        && request.resource.data.watermarkOpacity >= 0.02
        && request.resource.data.watermarkOpacity <= 0.3
        && request.resource.data.logoSize is number
        && request.resource.data.logoSize >= 6
        && request.resource.data.logoSize <= 24
        && request.resource.data.watermarkSize is number
        && request.resource.data.watermarkSize >= 20
        && request.resource.data.watermarkSize <= 75
        && request.resource.data.positions is map
        && request.resource.data.texts is map
        && request.resource.data.styles is map;
    }
  }
}
