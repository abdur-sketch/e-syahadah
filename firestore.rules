rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.id == studentId
        && request.resource.data.name is string
        && request.resource.data.arabicName is string
        && request.resource.data.level is string
        && request.resource.data.status in ['Lulus', 'Proses']
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && request.resource.data.scores is list
        && request.resource.data.scores.size() == 11;
      allow delete: if request.auth != null;
    }

    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.arabicName is string
        && request.resource.data.order is number
        && request.resource.data.active is bool;
      allow delete: if request.auth != null;
    }

    match /settings/institution {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.arabicName is string
        && request.resource.data.foundation is string
        && request.resource.data.arabicFoundation is string
        && request.resource.data.city is string
        && request.resource.data.principal is string
        && request.resource.data.arabicAddress is string;
    }
  }
}
